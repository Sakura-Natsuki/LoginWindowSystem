<Window x:Class="LoginWindowSystem.Views.RegisterWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LoginWindowSystem.ViewModels"
        xmlns:helpers="clr-namespace:LoginWindowSystem.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        mc:Ignorable="d"
        
        d:DataContext="{d:DesignInstance vm:RegisterViewModel, IsDesignTimeCreatable=True}"
        
        Title="CYBERPUNK 2077 // 新用户注册" Height="550" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Border CornerRadius="6" Background="#0d1117"
            BorderBrush="#f7e018" BorderThickness="1.5">

        <Grid Margin="30,25">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/> <!--0-->
                <RowDefinition Height="auto"/> <!--1-->
                <RowDefinition Height="auto"/> <!--2-->
                <RowDefinition Height="auto"/> <!--3-->
                <RowDefinition Height="auto"/> <!--4-->
                <RowDefinition Height="auto"/> <!--5-->
                <RowDefinition Height="auto"/> <!--6-->
                <RowDefinition Height="auto"/> <!--7-->
                <RowDefinition Height="auto"/> <!--8-->
                <RowDefinition Height="auto"/> <!--9-->
                
                <RowDefinition Height="auto"/> <!--10-->
                <RowDefinition Height="auto"/> <!--11-->
                
                <RowDefinition Height="10"/> <!--12-->
                
                <RowDefinition Height="auto"/> <!--13-->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="// 新用户注册 //"
                       Foreground="#f7e018" FontSize="22" FontWeight="Bold"
                       FontFamily="Consolas" HorizontalAlignment="Center"
                       Margin="0,0,0,2">

                <TextBlock.Effect>
                    
                    <DropShadowEffect Color="#f7e018" BlurRadius="10"
                                      ShadowDepth="0" Opacity="0.7"/>
                </TextBlock.Effect>
                
            </TextBlock>

            <TextBlock Grid.Row="1" Text="[创建身份凭证以接入系统]"
                       Foreground="#00f0ff" FontSize="11" FontFamily="Consolas"
                       HorizontalAlignment="Center" Opacity="0.7"/>

            <TextBlock Grid.Row="2" Text="> 用户标识_" Foreground="#00f0ff" 
                       FontFamily="Consolas" FontSize="13" Margin="0,8,0,4"/>

            <TextBox Grid.Row="3" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}"
                     Background="#161b22" FontFamily="Consolas" FontSize="15"
                     Padding="10,8" Height="40" Margin="0,0,0,8" CaretBrush="#00f0ff"/>

            <TextBlock Grid.Row="4" Text="> 访问密码_" Foreground="#00f0ff" 
                       FontFamily="Consolas" FontSize="13" Margin="0,8,0,4"/>

            <PasswordBox Grid.Row="5" x:Name="PwdBox"
                         Foreground="#f7e018" BorderBrush="#30363d" PasswordChanged="PwdBox_PasswordChanged"
                         Background="#161b22" FontFamily="Consolas" FontSize="15"
                         Padding="10,8" Height="40" Margin="0,0,0,8" CaretBrush="#00f0ff"/>

            <TextBlock Grid.Row="6" Text="> 确认密码_" Foreground="#00f0ff" 
                       FontFamily="Consolas" FontSize="13" Margin="0,8,0,4"/>

            <PasswordBox Grid.Row="7" x:Name="ConfirmPwdBox"
                         Foreground="#f7e018" BorderBrush="#30363d" PasswordChanged="ConfirmPwdBox_PasswordChanged"
                         Background="#161b22" FontFamily="Consolas" FontSize="15"
                         Padding="10,8" Height="40" Margin="0,0,0,8" CaretBrush="#00f0ff"/>

            <TextBlock Grid.Row="8" Text="> 用户昵称_" Foreground="#00f0ff" 
                       FontFamily="Consolas" FontSize="13" Margin="0,8,0,4"/>

            <TextBox Grid.Row="9" Text="{Binding NickName,UpdateSourceTrigger=PropertyChanged}"
                     Background="#161b22" Foreground="#f7e018" FontFamily="Consolas" FontSize="15"
                     BorderBrush="#30363d" Padding="10,8" Height="40" Margin="0,0,0,8" CaretBrush="#00f0ff"/>

            <TextBlock Grid.Row="10" Text="{Binding ErrorMessage}"
                       Foreground="#ff0040" FontSize="12" FontFamily="Consolas"
                       HorizontalAlignment="Center" Margin="0,6,0,6" Visibility="{Binding ErrorMessage,Converter={StaticResource StringToVisibilityConverter}}">

                <TextBlock.Effect>
                    <DropShadowEffect Color="#ff0040" BlurRadius="6" ShadowDepth="0"
                                      Opacity="0.5"/>
                </TextBlock.Effect>
                
            </TextBlock>

            <Button Grid.Row="11" Content="[ 注册 ]" Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsRegistering,Converter={StaticResource InverseBoolConverter}}"
                    Height="40" Margin="0,10,0,6" FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                    Foreground="#ff0040" Cursor="Hand">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        
                        <Border x:Name="registerBorder" Background="#f7e018" CornerRadius="2">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="registerBorder" Property="Background" Value="#ffd700"/>
                            </Trigger>
                            
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="registerBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            
                        </ControlTemplate.Triggers>
                        
                    </ControlTemplate>
                </Button.Template>

                <Button.Effect>
                    <DropShadowEffect Color="#f7e018" BlurRadius="10" ShadowDepth="0"
                                      Opacity="0.4"/>
                </Button.Effect>
                
            </Button>

            <TextBlock Grid.Row="13" Text="[ &lt;返回登录 ]"
                       FontSize="11" FontFamily="Consolas" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonDown="BackToLLogin_Click"
                       Background="Transparent">

                <TextBlock.Style>

                    <Style TargetType="TextBlock">

                        <Setter Property="Foreground" Value="#8b949e"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Foreground" Value="#00f0ff"/>

                            </Trigger>
                            
                        </Style.Triggers>

                    </Style>
                    
                </TextBlock.Style>
                    
            </TextBlock>
            
        </Grid>
    </Border>
</Window>
